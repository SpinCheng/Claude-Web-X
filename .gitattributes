# normalize text files in repo (LF); working copy per platform
* text=auto
# Windows scripts must stay CRLF on checkout
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
*.ps1 text eol=crlf
# binaries
*.png binary
*.ico binary
# POSIX shell scripts must keep LF everywhere (CRLF shebang breaks exec on Linux/macOS)
*.sh text eol=lf
