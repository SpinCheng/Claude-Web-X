' start-bridge.vbs - hidden launcher for the claude-remote bridge daemon.
' Runs from the repo (scripts/ folder): resolves the project root relative to
' this file, node.exe from PATH. The autostart copy in shell:startup is
' GENERATED by the pairing panel (bridge/pairing.js installAutostart) with
' absolute paths baked in - this file is the generic template.
' If the port is already taken, the bridge exits on its own (EADDRINUSE guard)
' so double starts are harmless.
Dim sh, fso, NODE, BASE, here
Set sh = CreateObject("WScript.Shell")
Set fso = CreateObject("Scripting.FileSystemObject")
NODE = "node.exe"
here = fso.GetParentFolderName(fso.GetParentFolderName(WScript.ScriptFullName))
BASE = here & "\bridge\index.js"
sh.Run """" & NODE & """ """ & BASE & """", 0, False
